# OpenWahi backend settings (app/config/settings.py).
# Copy to backend/.env for `make dev`. Values below target the services published
# by docker-compose.dev.yml on localhost. Inside Compose these are set by the
# compose file instead.

# --- Branding ---------------------------------------------------------------------
APP_NAME=OpenWahi

# --- Firebase Authentication (required) --------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account JSON downloaded from the Firebase console (keep it out of git).
FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/firebase-service-account.json

# --- Admin dashboard ---------------------------------------------------------------
# Comma-separated emails allowed to use /internal/admin/*. The Firebase account must
# have a verified email. Empty disables the admin API (it returns 404 to everyone).
ADMIN_EMAILS=

# --- Database (required) -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://openwahi:openwahi_dev_password@localhost:5432/openwahi

# --- FastAPI -----------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
# Comma-separated origins allowed by CORS and the Origin check (strict in production).
ALLOWED_ORIGINS=http://localhost:3000

# --- Encryption (required) ---------------------------------------------------------
# Fernet key that encrypts users' provider API keys. Generate one with:
#   uv run python generate_encryption_key.py
AI_ENCRYPTION_KEY=

# --- WhatsApp gateway (GOWA) -------------------------------------------------------
# GOWA location (read directly from the environment). Defaults: localhost:3000,
# or host "whatsapp" when running inside Docker. The dev compose publishes 3001.
GOWA_HOST=localhost
GOWA_PORT=3001
# Basic-auth credentials configured on GOWA (APP_BASIC_AUTH).
WHATSAPP_USER=admin
WHATSAPP_PASSWORD=dev-secret
# Shared secret GOWA uses to sign webhooks. Empty disables signature validation.
WHATSAPP_WEBHOOK_SECRET=dev-webhook-secret

# --- Audio transcription -----------------------------------------------------------
TRANSCRIBER_URL=http://localhost:8001

# --- AI providers ------------------------------------------------------------------
# Optional platform Groq key (users can bring their own keys).
GROQ_API_KEY=
# OpenAI-compatible llama.cpp server (see llamacpp/).
LLAMACPP_BASE_URL=http://localhost:8080/v1
LLAMACPP_MODEL=Qwen3.5-0.8B-Q8_0

# --- Managed AI (Pro plan: platform-provided keys) ---------------------------------
MANAGED_AI_PROVIDER=llamacpp
MANAGED_AI_MODEL=Qwen3.5-0.8B-Q8_0
# Local CPU models rarely emit tool calls; agent runs that need tools escalate here.
MANAGED_AI_TOOL_ESCALATION_ENABLED=True
MANAGED_AI_TOOL_PROVIDER=groq
MANAGED_AI_TOOL_MODEL=llama-3.3-70b-versatile
OPENCODE_GO_API_KEY=
BEDROCK_API_KEY=
PRO_MONTHLY_CONVERSATION_LIMIT=3000

# --- Vector database (Qdrant) ------------------------------------------------------
# Set QDRANT_URL (+ QDRANT_API_KEY) for Qdrant Cloud; otherwise host/port are used.
QDRANT_URL=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- Object storage (S3-compatible: bundled MinIO, AWS S3, Cloudflare R2...) -------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=openwahi
S3_SECRET_KEY=openwahi_dev_password
S3_BUCKET_NAME=openwahi
S3_REGION=us-east-1

# --- Embeddings --------------------------------------------------------------------
# sentence-transformers runs locally; jina and openai need the API keys below.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=multi-qa-MiniLM-L6-cos-v1
EMBEDDING_DIMENSIONS=384
JINA_API_KEY=
OPENAI_API_KEY=

# --- Knowledge base limits ---------------------------------------------------------
KB_MAX_FILE_SIZE_MB=5
KB_MAX_BASES_PER_USER=3
KB_MAX_DOCS_PER_BASE=30

# --- Sentry (optional) -------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
