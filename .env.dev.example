# openwahi — development stack (docker-compose.dev.yml)
#
#   cp .env.dev.example .env.dev
#   make dev
#
# Every variable below is read by docker-compose.dev.yml. Values are local
# development defaults or placeholders; never commit your real .env.dev.

COMPOSE_PROJECT_NAME=openwahi-dev

# --- Application -------------------------------------------------------------
APP_NAME=OpenWahi
# Comma-separated emails allowed into the admin panel (must be verified in
# Firebase). Empty disables the admin panel.
ADMIN_EMAILS=
ALLOWED_ORIGINS=http://localhost:3000

# --- Firebase Auth -----------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
# Host path of the Firebase Admin SDK service-account JSON (mounted read-only).
FIREBASE_SERVICE_ACCOUNT_FILE=./secrets/firebase-service-account.json

# --- Encryption ----------------------------------------------------------------
# Fernet key used to encrypt stored provider API keys and secrets. Generate one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=replace-with-a-fernet-key

# --- PostgreSQL ----------------------------------------------------------------
POSTGRES_USER=openwahi
POSTGRES_PASSWORD=openwahi_dev_password
POSTGRES_DB=openwahi

# --- Qdrant (vector store) -----------------------------------------------------
# Leave QDRANT_URL/QDRANT_API_KEY empty to use the bundled qdrant service.
# Set them to use a remote cluster (e.g. Qdrant Cloud) instead.
QDRANT_URL=
QDRANT_API_KEY=

# --- Object storage (S3-compatible) --------------------------------------------
# Defaults target the bundled minio service; S3_ACCESS_KEY/S3_SECRET_KEY are
# also its root credentials. Point S3_ENDPOINT_URL at any S3-compatible
# provider to use external storage (use S3_REGION=auto for Cloudflare R2).
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=openwahi
S3_SECRET_KEY=openwahi_dev_password
S3_BUCKET_NAME=openwahi
S3_REGION=us-east-1

# --- WhatsApp gateway (GOWA) -----------------------------------------------------
WHATSAPP_USER=admin
WHATSAPP_PASSWORD=dev-secret
WHATSAPP_WEBHOOK_SECRET=dev-webhook-secret

# --- AI --------------------------------------------------------------------------
# Optional Groq key: audio transcription fallback and tool-calling escalation.
GROQ_API_KEY=
WHISPER_MODEL=base
GROQ_TIMEOUT_SECONDS=10.0
MANAGED_AI_PROVIDER=llamacpp
MANAGED_AI_MODEL=Qwen3.5-0.8B-Q8_0
BEDROCK_API_KEY=

# Local CPU inference (llamacpp service)
LLAMACPP_BASE_URL=http://llamacpp:8080/v1
LLAMACPP_MODEL=Qwen3.5-0.8B-Q8_0
LLAMACPP_CONTEXT_SIZE=4096
LLAMACPP_MAX_TOKENS=512
LLAMACPP_THREADS=4
LLAMACPP_CPUS=4.0
LLAMACPP_MEMORY_LIMIT=3g

# Embeddings (computed locally by default)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=multi-qa-MiniLM-L6-cos-v1
EMBEDDING_DIMENSIONS=384

# --- Monitoring (optional) ---------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# --- Host ports --------------------------------------------------------------------
BACKEND_PORT=8000
POSTGRES_PORT=15432
QDRANT_REST_PORT=16333
QDRANT_GRPC_PORT=16334
MINIO_PORT=19000
WHATSAPP_PORT=3001
TRANSCRIBER_PORT=18001
LLAMACPP_PORT=8080
