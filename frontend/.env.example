# Copy to .env.local and adjust. All NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time — never put secrets here.

# Display name shown in the header, login page, page titles and admin panel.
NEXT_PUBLIC_APP_NAME=OpenWahi

# Backend API base URL (FastAPI). Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public URL of this frontend, used for auth redirects. Falls back to the request origin.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Firebase Authentication (Google sign-in). Web app config from the Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id

# Comma-separated list of emails allowed to sign in. Leave empty to allow everyone.
NEXT_PUBLIC_ALLOWED_EMAILS=

# Development only: accept a Firebase ID token injected into localStorage
# (fb_id_token) instead of the Google popup. Ignored in production builds.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Per-request timeout (ms) for AI sandbox tests; local CPU models may need a cold start.
NEXT_PUBLIC_AI_SANDBOX_TIMEOUT_MS=60000

# Optional: embed this instance's own support chat widget on every page.
# Create a widget token in AI Assistant → Get Widget. Leave empty to disable.
NEXT_PUBLIC_SUPPORT_WIDGET_TOKEN=
# Optional widget title. Defaults to "<NEXT_PUBLIC_APP_NAME> support".
NEXT_PUBLIC_SUPPORT_WIDGET_TITLE=
